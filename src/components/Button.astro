---
interface Props {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
}

const { href, type = 'submit', class: className, ...rest } = Astro.props;
const classes = ['btn', className].filter(Boolean).join(' ');
---

{
	href ? (
		<a class={classes} href={href} {...rest}>
			<slot />
		</a>
	) : (
		<button class={classes} type={type} {...rest}>
			<slot />
		</button>
	)
}
