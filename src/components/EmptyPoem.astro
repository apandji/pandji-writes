---
import { poems } from '../lib/poems';
---

<p class="empty-poem" data-empty-poem></p>
<script is:inline define:vars={{ poems }}>
	const node = document.currentScript?.previousElementSibling;
	if (node && poems.length > 0) {
		node.textContent = poems[Math.floor(Math.random() * poems.length)];
	}
</script>
