---
interface Props {
	draftKey?: string;
}

const { draftKey = 'post-draft' } = Astro.props;
---

<div class="md-editor" data-md-editor data-draft-key={draftKey}>
	<div class="md-toolbar" role="toolbar" aria-label="formatting">
		<div class="md-group" role="group" aria-label="headings">
			<button type="button" data-md="h1" title="Heading 1">H1</button>
			<button type="button" data-md="h2" title="Heading 2">H2</button>
			<button type="button" data-md="h3" title="Heading 3">H3</button>
		</div>
		<div class="md-group" role="group" aria-label="emphasis">
			<button type="button" data-md="bold" title="Bold (⌘B)"><strong>B</strong></button>
			<button type="button" data-md="italic" title="Italic (⌘I)"><em>I</em></button>
		</div>
		<div class="md-group" role="group" aria-label="lists">
			<button type="button" data-md="ul" title="Bulleted list">• list</button>
			<button type="button" data-md="ol" title="Numbered list">1. list</button>
			<button type="button" data-md="quote" title="Quote">quote</button>
		</div>
		<div class="md-group" role="group" aria-label="insert">
			<button type="button" data-md="code" title="Code">code</button>
			<button type="button" data-md="link" title="Link (⌘K)">link</button>
			<button type="button" data-md="image" title="Inline image">image</button>
			<button type="button" data-md="hr" title="Divider">—</button>
			<button type="button" data-md="diagram" title="Mermaid diagram">diagram</button>
		</div>
		<button type="button" data-md="preview" data-md-preview-toggle title="Toggle preview">preview</button>
	</div>
	<textarea
		class="md-body"
		name="body"
		rows="22"
		required
		data-md-body
		placeholder="Write here. Drop or paste images inline."
	></textarea>
	<div class="md-preview prose" hidden data-md-preview></div>
	<input
		type="file"
		name="images"
		accept="image/jpeg,image/png,image/webp,image/gif"
		multiple
		hidden
		data-md-images
	/>
	<div class="md-status">
		<span data-md-count>0 words</span>
		<span class="md-status-hint">⌘/Ctrl + Enter to save · drafts auto-saved</span>
		<span data-md-draft-note hidden>draft restored</span>
	</div>
</div>

<script>
	import { marked } from 'marked';

	const editor = document.querySelector('[data-md-editor]');
	const textarea = editor?.querySelector<HTMLTextAreaElement>('[data-md-body]');
	const preview = editor?.querySelector<HTMLElement>('[data-md-preview]');
	const previewToggle = editor?.querySelector<HTMLButtonElement>('[data-md-preview-toggle]');
	const input = editor?.querySelector<HTMLInputElement>('[data-md-images]');
	const countEl = editor?.querySelector<HTMLElement>('[data-md-count]');
	const draftNote = editor?.querySelector<HTMLElement>('[data-md-draft-note]');
	const form = editor?.closest('form');
	const title = form?.querySelector<HTMLInputElement>('input[name="title"]');
	const journal = form?.querySelector<HTMLSelectElement>('select[name="journal"]');
	const pubDate = form?.querySelector<HTMLInputElement>('input[name="pubDate"]');
	const draftKey = editor instanceof HTMLElement ? editor.dataset.draftKey || 'post-draft' : 'post-draft';

	if (editor instanceof HTMLElement && textarea && preview && previewToggle && input) {
		const surface = editor;
		const field = textarea;
		const pane = preview;
		const toggle = previewToggle;
		const fileInput = input;
		const bag = new DataTransfer();
		const blobs = new Map<string, string>();
		let skipChange = false;
		let showingPreview = false;
		let pendingCaret: { start: number; end: number } | null = null;
		let draftTimer = 0;

		marked.setOptions({ gfm: true, breaks: false });

		function slugCandidate() {
			return (
				title?.value
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-+|-+$/g, '')
					.slice(0, 40) || 'post'
			);
		}

		function wordCount(text: string) {
			const words = text.trim().match(/\S+/g);
			return words ? words.length : 0;
		}

		function updateCount() {
			if (!countEl) return;
			const n = wordCount(field.value);
			countEl.textContent = `${n} word${n === 1 ? '' : 's'}`;
		}

		function saveDraft() {
			try {
				localStorage.setItem(
					draftKey,
					JSON.stringify({
						title: title?.value ?? '',
						journal: journal?.value ?? '',
						pubDate: pubDate?.value ?? '',
						body: field.value,
						savedAt: Date.now(),
					}),
				);
			} catch {
				/* ignore quota */
			}
		}

		function scheduleDraft() {
			window.clearTimeout(draftTimer);
			draftTimer = window.setTimeout(saveDraft, 400);
		}

		function restoreDraft() {
			try {
				const raw = localStorage.getItem(draftKey);
				if (!raw) return;
				const draft = JSON.parse(raw) as {
					title?: string;
					journal?: string;
					pubDate?: string;
					body?: string;
				};
				if (!draft.body && !draft.title) return;
				const empty =
					!field.value.trim() &&
					!(title?.value ?? '').trim();
				if (!empty) return;
				if (title && draft.title) title.value = draft.title;
				if (journal && draft.journal) journal.value = draft.journal;
				if (pubDate && draft.pubDate) pubDate.value = draft.pubDate;
				if (draft.body) field.value = draft.body;
				if (draftNote) {
					draftNote.hidden = false;
					window.setTimeout(() => {
						if (draftNote) draftNote.hidden = true;
					}, 2500);
				}
			} catch {
				/* ignore */
			}
		}

		function clearDraft() {
			try {
				localStorage.removeItem(draftKey);
			} catch {
				/* ignore */
			}
		}

		function syncPreview() {
			if (!showingPreview) return;
			const html = marked.parse(field.value, { async: false }) as string;
			pane.innerHTML = html;
			for (const img of pane.querySelectorAll('img')) {
				const src = img.getAttribute('src') ?? '';
				const fileName = src.split('/').pop() ?? '';
				const blob = blobs.get(src) || blobs.get(fileName);
				if (blob) img.setAttribute('src', blob);
			}
		}

		function setPreview(on: boolean) {
			showingPreview = on;
			field.hidden = on;
			pane.hidden = !on;
			surface.classList.toggle('is-preview', on);
			toggle.textContent = on ? 'write' : 'preview';
			if (on) syncPreview();
			else field.focus();
		}

		function apply(next: string, selectStart: number, selectEnd: number) {
			field.value = next;
			field.setSelectionRange(selectStart, selectEnd);
			field.focus();
			updateCount();
			scheduleDraft();
			syncPreview();
		}

		function wrapInline(before: string, after: string, placeholder: string) {
			const start = field.selectionStart;
			const end = field.selectionEnd;
			const inner = field.value.slice(start, end) || placeholder;
			const next = `${field.value.slice(0, start)}${before}${inner}${after}${field.value.slice(end)}`;
			const innerStart = start + before.length;
			apply(next, innerStart, innerStart + inner.length);
		}

		function lineRange() {
			const start = field.selectionStart;
			const end = field.selectionEnd;
			const value = field.value;
			const from = value.lastIndexOf('\n', start - 1) + 1;
			let to = value.indexOf('\n', end);
			if (end > start && value[end - 1] === '\n') to = end - 1;
			else if (to === -1) to = value.length;
			return { from, to, block: value.slice(from, to) };
		}

		function setBlock(nextBlock: string, from: number, to: number) {
			field.setRangeText(nextBlock, from, to, 'end');
			field.focus();
			updateCount();
			scheduleDraft();
			syncPreview();
		}

		function heading(level: number) {
			const marks = '#'.repeat(level);
			const { from, to, block } = lineRange();
			const nextBlock = block
				.split('\n')
				.map((line) => {
					const bare = line.replace(/^#{1,6}\s+/, '');
					return `${marks} ${bare || 'heading'}`;
				})
				.join('\n');
			setBlock(nextBlock, from, to);
		}

		function prefixLines(prefix: string, ordered = false) {
			const { from, to, block } = lineRange();
			const nextBlock = block
				.split('\n')
				.map((line, index) => {
					const bare = line.replace(/^(?:[-*+]|\d+\.)\s+/, '').replace(/^>\s?/, '');
					if (ordered) return `${index + 1}. ${bare}`;
					return `${prefix}${bare}`;
				})
				.join('\n');
			setBlock(nextBlock, from, to);
		}

		function insertAtCursor(text: string, selectOffset = text.length, selectLength = 0) {
			if (pendingCaret) {
				field.setSelectionRange(pendingCaret.end, pendingCaret.end);
				pendingCaret = null;
			} else {
				field.setSelectionRange(field.selectionEnd, field.selectionEnd);
			}
			const start = field.selectionStart;
			const before = field.value.slice(0, start);
			const pad = before && !before.endsWith('\n') ? '\n' : '';
			const chunk = `${pad}${text}`;
			field.setRangeText(chunk, start, start, 'end');
			if (selectLength > 0) {
				const inner = start + pad.length + selectOffset;
				field.setSelectionRange(inner, inner + selectLength);
			}
			field.focus();
			updateCount();
			scheduleDraft();
			syncPreview();
		}

		function insertLink() {
			const url = window.prompt('url');
			if (!url) {
				field.focus();
				return;
			}
			const start = field.selectionStart;
			const end = field.selectionEnd;
			const selected = field.value.slice(start, end);
			const inner = selected || 'text';
			const snippet = `[${inner}](${url})`;
			const next = `${field.value.slice(0, start)}${snippet}${field.value.slice(end)}`;
			const innerStart = start + 1;
			apply(next, innerStart, innerStart + inner.length);
		}

		function insertDiagram() {
			const fence = '```mermaid\nflowchart LR\n  A --> B\n```';
			insertAtCursor(fence, '```mermaid\nflowchart LR\n  '.length, 'A --> B'.length);
		}

		function insertCode() {
			const selected = field.value.slice(field.selectionStart, field.selectionEnd);
			if (selected.includes('\n')) wrapInline('```\n', '\n```', 'code');
			else wrapInline('`', '`', 'code');
		}

		function insertHr() {
			insertAtCursor('---\n', 0, 0);
		}

		function run(action: string) {
			if (action === 'preview') {
				setPreview(!showingPreview);
				return;
			}
			if (showingPreview) setPreview(false);
			if (action === 'bold') wrapInline('**', '**', 'bold');
			else if (action === 'italic') wrapInline('*', '*', 'italic');
			else if (action === 'h1') heading(1);
			else if (action === 'h2') heading(2);
			else if (action === 'h3') heading(3);
			else if (action === 'ul') prefixLines('- ');
			else if (action === 'ol') prefixLines('', true);
			else if (action === 'quote') prefixLines('> ');
			else if (action === 'code') insertCode();
			else if (action === 'link') insertLink();
			else if (action === 'hr') insertHr();
			else if (action === 'image') {
				pendingCaret = { start: field.selectionStart, end: field.selectionEnd };
				fileInput.click();
			} else if (action === 'diagram') insertDiagram();
		}

		function insertImages(files: File[]) {
			const slug = slugCandidate();
			const snippets = files
				.filter((file) => file.type.startsWith('image/'))
				.map((file) => `![${file.name}](/uploads/${slug}/${file.name})`);
			if (snippets.length === 0) return;
			insertAtCursor(snippets.join('\n'));
		}

		function addFiles(files: FileList | File[]) {
			const incoming = [...files].filter((file) => file.type.startsWith('image/'));
			if (incoming.length === 0) return;

			for (const file of incoming) {
				bag.items.add(file);
				const url = URL.createObjectURL(file);
				blobs.set(file.name, url);
				blobs.set(`/uploads/${slugCandidate()}/${file.name}`, url);
			}

			skipChange = true;
			fileInput.files = bag.files;
			skipChange = false;
			insertImages(incoming);
		}

		surface.querySelector('.md-toolbar')?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest('button[data-md]');
			if (!(button instanceof HTMLButtonElement)) return;
			run(button.dataset.md ?? '');
		});

		field.addEventListener('keydown', (event) => {
			if ((event.metaKey || event.ctrlKey) && !event.altKey) {
				const key = event.key.toLowerCase();
				if (key === 'b') {
					event.preventDefault();
					run('bold');
					return;
				}
				if (key === 'i') {
					event.preventDefault();
					run('italic');
					return;
				}
				if (key === 'k') {
					event.preventDefault();
					run('link');
					return;
				}
				if (key === 'enter') {
					event.preventDefault();
					form?.requestSubmit();
					return;
				}
			}

			if (event.key === 'Tab') {
				const { from, to, block } = lineRange();
				const lines = block.split('\n');
				const listLike = lines.every((line) => /^(?:[-*+]|\d+\.|>)\s/.test(line) || line === '');
				if (!listLike) return;
				event.preventDefault();
				const next = event.shiftKey
					? lines.map((line) => line.replace(/^ {0,2}/, '')).join('\n')
					: lines.map((line) => (line ? `  ${line}` : line)).join('\n');
				setBlock(next, from, to);
			}
		});

		field.addEventListener('input', () => {
			updateCount();
			scheduleDraft();
			syncPreview();
		});

		title?.addEventListener('input', scheduleDraft);
		journal?.addEventListener('change', scheduleDraft);
		pubDate?.addEventListener('change', scheduleDraft);

		field.addEventListener('dragover', (event) => {
			if (event.dataTransfer?.types.includes('Files')) {
				event.preventDefault();
				surface.classList.add('is-over');
			}
		});
		field.addEventListener('dragleave', () => surface.classList.remove('is-over'));
		field.addEventListener('drop', (event) => {
			surface.classList.remove('is-over');
			if (!event.dataTransfer?.files.length) return;
			event.preventDefault();
			addFiles(event.dataTransfer.files);
		});

		field.addEventListener('paste', (event) => {
			const files = [...(event.clipboardData?.files ?? [])].filter((file) =>
				file.type.startsWith('image/'),
			);
			if (files.length === 0) return;
			event.preventDefault();
			addFiles(files);
		});

		fileInput.addEventListener('change', () => {
			if (skipChange) return;
			addFiles(fileInput.files ?? []);
		});

		form?.addEventListener('submit', () => {
			clearDraft();
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (submit) {
				submit.disabled = true;
				submit.textContent = 'saving…';
			}
		});

		restoreDraft();
		updateCount();
	}
</script>
