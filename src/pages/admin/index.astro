---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { journalMark } from '../../lib/site';
import { listJournalsForAdmin } from '../../lib/github';

const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');
let journals: { id: string; title: string; emoji?: string }[] = [];
let loadError = '';

try {
	journals = await listJournalsForAdmin();
} catch (err) {
	loadError = err instanceof Error ? err.message : 'could not read the repo.';
}

const note =
	saved === 'journal'
		? 'journal committed. the site will catch up in a minute.'
		: saved === 'post'
			? 'post published. the site will catch up in a minute.'
			: saved === 'order'
				? 'order saved. the site will catch up in a minute.'
				: '';
---

<AdminLayout>
	{note && <p class="admin-note">{note}</p>}
	{loadError && <p class="admin-error">{loadError}</p>}
	{error && <p class="admin-error">{error}</p>}

	<section class="admin-section">
		<header class="write-header">
			<p class="admin-kicker admin-kicker--row">
				journals
				<a class="admin-add" href="/admin/journals/new" aria-label="new journal">+</a>
			</p>
		</header>
		{
			journals.length === 0 && !loadError ? (
				<p class="empty">nothing here yet.</p>
			) : (
				<ul class="admin-list">
					{journals.map((journal, index) => (
						<li>
							<span class="home-mark" aria-hidden="true">
								{journalMark(journal.id, journal.emoji)}
							</span>
							<a class="admin-journal-name" href={`/admin/journals/${journal.id}`}>
								{journal.title}
							</a>
							<span class="admin-order">
								<form method="post" action="/api/admin/journals">
									<input type="hidden" name="intent" value="reorder" />
									<input type="hidden" name="id" value={journal.id} />
									<input type="hidden" name="dir" value="up" />
									<button class="admin-text-btn" type="submit" disabled={index === 0}>
										up
									</button>
								</form>
								<form method="post" action="/api/admin/journals">
									<input type="hidden" name="intent" value="reorder" />
									<input type="hidden" name="id" value={journal.id} />
									<input type="hidden" name="dir" value="down" />
									<button
										class="admin-text-btn"
										type="submit"
										disabled={index === journals.length - 1}
									>
										down
									</button>
								</form>
							</span>
							<a
								class="admin-journal-write"
								href={`/admin/posts/new?journal=${encodeURIComponent(journal.id)}`}
							>
								write
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>
