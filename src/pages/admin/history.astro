---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatHistoryTime } from '../../lib/history';
import { readHistory } from '../../lib/github';

const entries = await readHistory();
---

<AdminLayout
	title="history"
	crumbs={[
		{ href: '/admin', label: 'admin' },
		{ label: 'history' },
	]}
>
	<section class="admin-section">
		<p class="admin-kicker">history</p>
		{
			entries.length === 0 ? (
				<p class="empty-poem">nothing logged yet.</p>
			) : (
				<ul class="admin-history">
					{entries.map((entry) => (
						<li>
							<time datetime={entry.at}>{formatHistoryTime(entry.at)}</time>
							<p>{entry.summary}</p>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>
