---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import Button from '../../../components/Button.astro';
import { getPostForAdmin, listJournalsForAdmin } from '../../../lib/github';

let journals: { id: string; title: string }[] = [];
let loadError = '';

try {
	journals = await listJournalsForAdmin();
} catch (error) {
	loadError = error instanceof Error ? error.message : 'could not read journals.';
}

const today = new Date().toISOString().slice(0, 10);
const selectedJournal = Astro.url.searchParams.get('journal') ?? '';
const slug = Astro.url.searchParams.get('slug') ?? '';
const resume = Astro.url.searchParams.get('resume') === '1';
const existing = slug ? await getPostForAdmin(slug) : null;
const error = Astro.url.searchParams.get('error');
const errorText =
	error === 'missing'
		? 'title, journal, and date are required.'
		: error === 'date'
			? 'that date looks off.'
			: error === 'journal'
				? 'pick a journal that exists.'
				: error === 'images'
					? 'images need to be jpeg, png, webp, or gif, under 1 MB, and no more than four.'
					: error;

const journalId = existing?.journal || (journals.some((item) => item.id === selectedJournal) ? selectedJournal : '');
const journal = journals.find((item) => item.id === journalId);
const editing = Boolean(existing);
const crumbLabel = existing?.title
	? existing.title.toLowerCase()
	: editing
		? 'edit'
		: 'new post';
---

<AdminLayout
	title={editing ? existing?.title || 'edit post' : 'new post'}
	wide
	crumbs={[
		{ href: '/admin', label: 'admin' },
		...(journal
			? [{ href: `/admin/journals/${journal.id}`, label: journal.title.toLowerCase() }]
			: []),
		{ label: crumbLabel },
	]}
>
	{
		loadError ? (
			<p class="admin-error">{loadError}</p>
		) : journals.length === 0 ? (
			<p class="empty-poem">
				make a journal first. <a href="/admin/journals/new">+</a>
			</p>
		) : (
			<form
				class="admin-form admin-form--write"
				method="post"
				action="/api/admin/posts"
				enctype="multipart/form-data"
				data-resume={resume ? '1' : '0'}
				data-prefer-journal={journalId}
			>
				{existing && <input type="hidden" name="slug" value={existing.id} />}
				<input type="hidden" name="intent" value="publish" data-intent />

				<div class="write-meta">
					<label>
						<span>journal</span>
						<select name="journal" required>
							{journals.map((item) => (
								<option value={item.id} selected={item.id === journalId}>
									{item.title}
								</option>
							))}
						</select>
					</label>
					<label class="write-title">
						<span>title</span>
						<input
							type="text"
							name="title"
							required
							maxlength="120"
							placeholder="what is this about?"
							value={existing?.title ?? ''}
						/>
					</label>
					<label>
						<span>date</span>
						<input type="date" name="pubDate" value={existing?.pubDate || today} required />
					</label>
				</div>

				<div class="admin-field write-body">
					<span class="write-body-label">body</span>
					<MarkdownEditor value={existing?.body ?? ''} />
				</div>

				<div class="write-actions">
					<div class="write-actions-buttons">
						<Button data-set-intent="draft">save draft</Button>
						<Button data-set-intent="publish">publish</Button>
					</div>
					<p class="admin-hint">draft stays private · publish waits for a rebuild</p>
				</div>
				{errorText && <p class="admin-error">{errorText}</p>}
			</form>
		)
	}
</AdminLayout>
