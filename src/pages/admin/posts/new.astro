---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import PublishDing from '../../../components/PublishDing.astro';
import Button from '../../../components/Button.astro';
import { getPostForAdmin, listJournalsForAdmin } from '../../../lib/github';

const slug = Astro.url.searchParams.get('slug') ?? '';
const selectedJournal = Astro.url.searchParams.get('journal') ?? '';
const resume = Astro.url.searchParams.get('resume') === '1';

let journals: { id: string; title: string }[] = [];
let existing: Awaited<ReturnType<typeof getPostForAdmin>> = null;
let loadError = '';

try {
	[journals, existing] = await Promise.all([
		listJournalsForAdmin(),
		slug ? getPostForAdmin(slug) : Promise.resolve(null),
	]);
} catch (error) {
	loadError = error instanceof Error ? error.message : 'could not read journals.';
}

const today = new Date().toISOString().slice(0, 10);
const error = Astro.url.searchParams.get('error');
const errorText =
	error === 'missing'
		? 'title, journal, and date are required.'
		: error === 'date'
			? 'that date looks off.'
			: error === 'journal'
				? 'pick a journal that exists.'
				: error === 'images'
					? 'images need to be jpeg, png, webp, or gif, under 1 MB, and no more than four.'
					: error;

const journalId = existing?.journal || (journals.some((item) => item.id === selectedJournal) ? selectedJournal : '');
const journal = journals.find((item) => item.id === journalId);
const editing = Boolean(existing);
const crumbLabel = existing?.title ? existing.title : editing ? 'edit' : 'new post';
const draftKey = existing ? `post-draft:${existing.id}` : 'post-draft:new';
const liveHref =
	existing && !existing.draft && journal
		? `/journals/${journal.id}/${existing.id}`
		: '';
---

<AdminLayout
	title={editing ? existing?.title || 'edit post' : 'new post'}
	wide
	crumbs={[
		{ href: '/admin', label: 'admin' },
		...(journal
			? [{ href: `/admin/journals/${journal.id}`, label: journal.title }]
			: []),
		{ label: crumbLabel },
	]}
>
	{
		loadError ? (
			<p class="admin-error">{loadError}</p>
		) : journals.length === 0 ? (
			<p class="empty">
				make a journal first. <a href="/admin/journals/new">+</a>
			</p>
		) : (
			<form
				class="admin-form admin-form--write"
				method="post"
				action="/api/admin/posts"
				enctype="multipart/form-data"
				data-resume={resume ? '1' : '0'}
				data-prefer-journal={journalId}
				data-write-desk
				data-draft-key={draftKey}
			>
				{existing && <input type="hidden" name="slug" value={existing.id} />}
				<input type="hidden" name="intent" value="draft" data-intent />

				<div class="write-desk-top">
					<label class="write-title write-title--hero">
						<span class="visually-hidden">title</span>
						<input
							type="text"
							name="title"
							required
							maxlength="120"
							placeholder="what is this about?"
							value={existing?.title ?? ''}
							autocomplete="off"
						/>
					</label>
					<div class="write-desk-tools">
						{liveHref && (
							<a class="write-live-link" href={liveHref} target="_blank" rel="noreferrer">
								view live
							</a>
						)}
						<button type="button" class="theme-toggle" data-write-focus>
							focus
						</button>
					</div>
				</div>

				<div class="write-meta write-meta--quiet">
					<label>
						<span>journal</span>
						<select name="journal" required>
							{journals.map((item) => (
								<option value={item.id} selected={item.id === journalId}>
									{item.title}
								</option>
							))}
						</select>
					</label>
					<label>
						<span>date</span>
						<input type="date" name="pubDate" value={existing?.pubDate || today} required />
					</label>
				</div>

				<div class="admin-field write-body">
					<MarkdownEditor value={existing?.body ?? ''} draftKey={draftKey} />
				</div>

				<div class="write-actions">
					<div class="write-actions-buttons">
						<Button data-set-intent="draft">save draft</Button>
						<Button data-set-intent="publish">publish</Button>
					</div>
					<p class="admin-hint">
						⌘/Ctrl+Enter saves a draft · ⌘/Ctrl+Shift+Enter publishes · the site catches up after publish
					</p>
				</div>
				{errorText && <p class="admin-error">{errorText}</p>}
			</form>
		)
	}
</AdminLayout>

<PublishDing />

<script>
	const desk = document.querySelector('[data-write-desk]');
	const focusBtn = document.querySelector<HTMLButtonElement>('[data-write-focus]');
	const title = desk?.querySelector<HTMLInputElement>('input[name="title"]');
	const body = desk?.querySelector<HTMLTextAreaElement>('[data-md-body]');

	function setFocus(on: boolean) {
		document.body.classList.toggle('is-write-focus', on);
		if (focusBtn) focusBtn.textContent = on ? 'leave focus' : 'focus';
	}

	focusBtn?.addEventListener('click', () => {
		setFocus(!document.body.classList.contains('is-write-focus'));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && document.body.classList.contains('is-write-focus')) {
			setFocus(false);
		}
	});

	if (body && !body.value.trim()) {
		body.focus();
	} else if (title && !title.value.trim()) {
		title.focus();
	}
</script>
