---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listJournalsFromRepo } from '../../../lib/github';

let journals: { id: string; title: string }[] = [];
let loadError = '';

try {
	journals = await listJournalsFromRepo();
} catch (error) {
	loadError = error instanceof Error ? error.message : 'could not read journals.';
}

const today = new Date().toISOString().slice(0, 10);
const error = Astro.url.searchParams.get('error');
const errorText =
	error === 'missing'
		? 'title, journal, and date are required.'
		: error === 'date'
			? 'that date looks off.'
			: error === 'journal'
				? 'pick a journal that exists.'
				: error === 'images'
					? 'images need to be jpeg, png, webp, or gif, under 1 MB, and no more than four.'
					: error;
---

<AdminLayout title="new post">
	{
		loadError ? (
			<p class="admin-error">{loadError}</p>
		) : journals.length === 0 ? (
			<p class="empty-poem">make a journal first.</p>
		) : (
			<form class="admin-form" method="post" action="/api/admin/posts" enctype="multipart/form-data">
				<p class="admin-kicker">new post</p>
				<label>
					<span>journal</span>
					<select name="journal" required>
						{journals.map((journal) => (
							<option value={journal.id}>{journal.title}</option>
						))}
					</select>
				</label>
				<label>
					<span>title</span>
					<input type="text" name="title" required maxlength="120" />
				</label>
				<label>
					<span>date</span>
					<input type="date" name="pubDate" value={today} required />
				</label>
				<label>
					<span>body</span>
					<textarea name="body" rows="16" required></textarea>
				</label>
				<div class="dropzone" data-dropzone>
					<p>drop images here</p>
					<input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
				</div>
				<ul class="drop-list" data-drop-list></ul>
				<p class="admin-hint">jpeg, png, webp, gif. under 1 MB each.</p>
				<button type="submit">save</button>
				{errorText && <p class="admin-error">{errorText}</p>}
			</form>
		)
	}
</AdminLayout>

<script>
	const zone = document.querySelector('[data-dropzone]');
	const input = zone?.querySelector('input[type="file"]');
	const list = document.querySelector('[data-drop-list]');
	const body = document.querySelector<HTMLTextAreaElement>('textarea[name="body"]');
	const title = document.querySelector<HTMLInputElement>('input[name="title"]');

	if (zone instanceof HTMLElement && input instanceof HTMLInputElement) {
		let skipChange = false;

		function slugCandidate() {
			return (
				title?.value
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-+|-+$/g, '')
					.slice(0, 40) || 'post'
			);
		}

		function insertMarkdown(files: File[]) {
			if (!body) return;
			const slug = slugCandidate();
			const snippets = files
				.filter((file) => file.type.startsWith('image/'))
				.map((file) => `![${file.name}](/uploads/${slug}/${file.name})`);
			if (snippets.length === 0) return;
			body.value = `${body.value.trim()}\n\n${snippets.join('\n')}\n`.trimStart();
		}

		function render() {
			if (!list) return;
			list.replaceChildren();
			for (const file of input.files ?? []) {
				const item = document.createElement('li');
				item.textContent = file.name;
				list.append(item);
			}
		}

		function addFiles(files: FileList | File[]) {
			const incoming = [...files].filter((file) => file.type.startsWith('image/'));
			const current = new DataTransfer();
			for (const file of input.files ?? []) current.items.add(file);
			for (const file of incoming) current.items.add(file);
			skipChange = true;
			input.files = current.files;
			skipChange = false;
			insertMarkdown(incoming);
			render();
		}

		zone.addEventListener('click', () => input.click());
		zone.addEventListener('dragover', (event) => {
			event.preventDefault();
			zone.classList.add('is-over');
		});
		zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));
		zone.addEventListener('drop', (event) => {
			event.preventDefault();
			zone.classList.remove('is-over');
			if (event.dataTransfer?.files.length) addFiles(event.dataTransfer.files);
		});
		input.addEventListener('click', (event) => event.stopPropagation());
		input.addEventListener('change', () => {
			if (skipChange) return;
			insertMarkdown([...(input.files ?? [])]);
			render();
		});
	}
</script>
