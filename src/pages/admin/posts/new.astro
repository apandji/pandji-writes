---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { listJournalsForAdmin } from '../../../lib/github';

let journals: { id: string; title: string }[] = [];
let loadError = '';

try {
	journals = await listJournalsForAdmin();
} catch (error) {
	loadError = error instanceof Error ? error.message : 'could not read journals.';
}

const today = new Date().toISOString().slice(0, 10);
const error = Astro.url.searchParams.get('error');
const errorText =
	error === 'missing'
		? 'title, journal, and date are required.'
		: error === 'date'
			? 'that date looks off.'
			: error === 'journal'
				? 'pick a journal that exists.'
				: error === 'images'
					? 'images need to be jpeg, png, webp, or gif, under 1 MB, and no more than four.'
					: error;
---

<AdminLayout title="new post" wide>
	{
		loadError ? (
			<p class="admin-error">{loadError}</p>
		) : journals.length === 0 ? (
			<p class="empty-poem">make a journal first.</p>
		) : (
			<form class="admin-form admin-form--write" method="post" action="/api/admin/posts" enctype="multipart/form-data">
				<header class="write-header">
					<p class="admin-kicker">new post</p>
					{errorText && <p class="admin-error">{errorText}</p>}
				</header>

				<div class="write-meta">
					<label>
						<span>journal</span>
						<select name="journal" required>
							{journals.map((journal) => (
								<option value={journal.id}>{journal.title}</option>
							))}
						</select>
					</label>
					<label class="write-title">
						<span>title</span>
						<input type="text" name="title" required maxlength="120" placeholder="what is this about?" />
					</label>
					<label>
						<span>date</span>
						<input type="date" name="pubDate" value={today} required />
					</label>
				</div>

				<div class="admin-field write-body">
					<span class="write-body-label">body</span>
					<MarkdownEditor />
				</div>

				<div class="write-actions">
					<button type="submit">save</button>
					<p class="admin-hint">images go inline via the toolbar, paste, or drop into the body.</p>
				</div>
			</form>
		)
	}
</AdminLayout>
