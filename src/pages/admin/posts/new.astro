---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { listJournalsFromRepo } from '../../../lib/github';

let journals: { id: string; title: string }[] = [];
let loadError = '';

try {
	journals = await listJournalsFromRepo();
} catch (error) {
	loadError = error instanceof Error ? error.message : 'could not read journals.';
}

const today = new Date().toISOString().slice(0, 10);
const error = Astro.url.searchParams.get('error');
const errorText =
	error === 'missing'
		? 'title, journal, and date are required.'
		: error === 'date'
			? 'that date looks off.'
			: error === 'journal'
				? 'pick a journal that exists.'
				: error === 'images'
					? 'images need to be jpeg, png, webp, or gif, under 1 MB, and no more than four.'
					: error;
---

<AdminLayout title="new post">
	{
		loadError ? (
			<p class="admin-error">{loadError}</p>
		) : journals.length === 0 ? (
			<p class="empty-poem">make a journal first.</p>
		) : (
			<form class="admin-form" method="post" action="/api/admin/posts" enctype="multipart/form-data">
				<p class="admin-kicker">new post</p>
				<label>
					<span>journal</span>
					<select name="journal" required>
						{journals.map((journal) => (
							<option value={journal.id}>{journal.title}</option>
						))}
					</select>
				</label>
				<label>
					<span>title</span>
					<input type="text" name="title" required maxlength="120" />
				</label>
				<label>
					<span>date</span>
					<input type="date" name="pubDate" value={today} required />
				</label>
				<div class="admin-field">
					<span>body</span>
					<MarkdownEditor />
				</div>
				<div class="dropzone" data-dropzone>
					<p>drop images here</p>
					<input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
				</div>
				<ul class="drop-list" data-drop-list></ul>
				<p class="admin-hint">jpeg, png, webp, gif. under 1 MB each.</p>
				<button type="submit">save</button>
				{errorText && <p class="admin-error">{errorText}</p>}
			</form>
		)
	}
</AdminLayout>
