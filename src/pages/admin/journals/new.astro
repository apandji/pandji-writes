---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { journalMarks } from '../../../lib/site';

const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="new journal">
	<form class="admin-form admin-form--journal" method="post" action="/api/admin/journals">
		<header class="write-header">
			<p class="admin-kicker">new journal</p>
			{error && <p class="admin-error">{error === 'title' ? 'needs a title.' : error}</p>}
		</header>

		<label>
			<span>title</span>
			<input type="text" name="title" required maxlength="80" placeholder="series name" autofocus />
		</label>

		<fieldset class="mark-picker">
			<legend>symbol</legend>
			<label class="mark-choice">
				<input type="radio" name="emoji" value="" checked />
				<span>random</span>
			</label>
			{
				journalMarks.map((mark) => (
					<label class="mark-choice">
						<input type="radio" name="emoji" value={mark} />
						<span>{mark}</span>
					</label>
				))
			}
		</fieldset>

		<div class="write-actions">
			<button type="submit">save</button>
			<p class="admin-hint">shows on the homepage with its own feed.</p>
		</div>
	</form>
</AdminLayout>
