---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PublishDing from '../../../../components/PublishDing.astro';
import { formatDate } from '../../../../lib/site';
import { listJournalsForAdmin, listPostsForAdmin } from '../../../../lib/github';
import Button from '../../../../components/Button.astro';

const { journal: journalId } = Astro.params;
const saved = Astro.url.searchParams.get('saved');
const publishedSlug = Astro.url.searchParams.get('slug') ?? '';
const clearDraftKey = Astro.url.searchParams.get('clear') ?? '';

const journals = await listJournalsForAdmin();
const journal = journals.find((item) => item.id === journalId);

if (!journal) {
	return Astro.redirect('/admin');
}

const posts = (await listPostsForAdmin()).filter((post) => post.journal === journal.id);
const liveHref = publishedSlug ? `/journals/${journal.id}/${publishedSlug}` : `/journals/${journal.id}`;
const writeHref = `/admin/posts/new?journal=${encodeURIComponent(journal.id)}`;

function parseDay(value: string) {
	const date = new Date(`${value}T00:00:00Z`);
	return Number.isNaN(date.valueOf()) ? value : formatDate(date);
}
---

<AdminLayout
	title={journal.title}
	crumbs={[
		{ href: '/admin', label: 'admin' },
		{ label: journal.title },
	]}
>
	{
		saved === 'draft' && (
			<p class="admin-note" data-clear-draft={clearDraftKey || 'post-draft:new'}>
				draft saved. it stays off the public site until you publish.
			</p>
		)
	}
	{
		saved === 'post' && (
			<div class="publish-ritual" data-publish-ritual data-clear-draft={clearDraftKey || 'post-draft:new'}>
				<p class="publish-ritual-line">it is written, this is the way.</p>
				<p class="publish-ritual-links">
					<a href={liveHref}>open it</a>
					<span aria-hidden="true">·</span>
					<a href={writeHref}>keep writing</a>
					<span aria-hidden="true">·</span>
					<span class="publish-ritual-soft">the site will catch up</span>
				</p>
			</div>
		)
	}

	<section class="admin-section">
		<header class="write-header">
			<p class="admin-kicker">posts</p>
			<div class="write-header-actions">
				<a class="admin-journal-write" href={`/admin/journals/${journal.id}/settings`}>settings</a>
				<Button href={writeHref}>write</Button>
			</div>
		</header>
		{
			posts.length === 0 ? (
				<p class="empty">nothing written yet.</p>
			) : (
				<ul class="admin-list">
					{posts.map((post) => (
						<li>
							<a
								class="admin-journal-name"
								href={`/admin/posts/new?journal=${encodeURIComponent(journal.id)}&slug=${encodeURIComponent(post.id)}`}
							>
								{post.title}
							</a>
							<span class="admin-post-meta">
								<span class="admin-flag">{post.draft ? 'draft' : 'live'}</span>
								<span aria-hidden="true">·</span>
								<span class="admin-post-date">{parseDay(post.pubDate)}</span>
							</span>
							{!post.draft && (
								<a
									class="admin-journal-write"
									href={`/journals/${journal.id}/${post.id}`}
									target="_blank"
									rel="noreferrer"
								>
									open
								</a>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>

{saved === 'post' && <PublishDing />}

<script>
	const clearNode = document.querySelector<HTMLElement>('[data-clear-draft]');
	if (clearNode) {
		const key = clearNode.dataset.clearDraft;
		try {
			if (key) localStorage.removeItem(key);
			localStorage.removeItem('post-draft');
			localStorage.removeItem('post-draft:new');
		} catch {
			/* ignore */
		}
	}
	if (document.querySelector('[data-publish-ritual]')) {
		window.playPublishDing?.();
	}
</script>
