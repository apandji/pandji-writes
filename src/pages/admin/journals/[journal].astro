---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, journalMark } from '../../../lib/site';
import { listJournalsForAdmin, listPostsForAdmin } from '../../../lib/github';
import Button from '../../../components/Button.astro';
import MarkPicker from '../../../components/MarkPicker.astro';

const { journal: journalId } = Astro.params;
const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');

const journals = await listJournalsForAdmin();
const journal = journals.find((item) => item.id === journalId);

if (!journal) {
	return Astro.redirect('/admin');
}

const posts = (await listPostsForAdmin()).filter((post) => post.journal === journal.id);
const mark = journalMark(journal.id, journal.emoji);

function parseDay(value: string) {
	const date = new Date(`${value}T00:00:00Z`);
	return Number.isNaN(date.valueOf()) ? value : formatDate(date);
}
---

<AdminLayout
	title={journal.title}
	crumbs={[
		{ href: '/admin', label: 'admin' },
		{ label: journal.title.toLowerCase() },
	]}
>
	{
		saved === 'journal' && (
			<p class="admin-note">journal committed. the site will catch up in a minute.</p>
		)
	}
	{
		saved === 'post' && (
			<p class="admin-note" data-clear-draft>
				post published. the site will catch up in a minute.
			</p>
		)
	}
	{error === 'title' && <p class="admin-error">needs a name.</p>}
	{error && error !== 'title' && <p class="admin-error">{error}</p>}

	<section class="admin-section">
		<form class="admin-form admin-form--journal" method="post" action="/api/admin/journals">
			<input type="hidden" name="intent" value="update" />
			<input type="hidden" name="id" value={journal.id} />
			<label>
				<span>name</span>
				<input type="text" name="title" required maxlength="80" value={journal.title} />
			</label>
			<MarkPicker selected={mark} />
			<div class="write-actions">
				<Button>save</Button>
				<p class="admin-hint">name and symbol on the site. the address stays the same.</p>
			</div>
		</form>
	</section>

	<section class="admin-section">
		<p class="admin-kicker">posts</p>
		{
			posts.length === 0 ? (
				<p class="empty-poem">nothing written yet.</p>
			) : (
				<ul class="admin-list">
					{posts.map((post) => (
						<li>
							<a
								class="admin-journal-name"
								href={`/admin/posts/new?journal=${encodeURIComponent(journal.id)}&slug=${encodeURIComponent(post.id)}`}
							>
								{post.title}
							</a>
							<span class:list={['admin-flag', post.draft ? 'is-draft' : 'is-live']}>
								{post.draft ? 'draft' : 'live'}
							</span>
							<span class="admin-post-date">{parseDay(post.pubDate)}</span>
							<a
								class="admin-journal-write"
								href={`/admin/posts/new?journal=${encodeURIComponent(journal.id)}&slug=${encodeURIComponent(post.id)}`}
							>
								edit
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="admin-write-row">
			<Button href={`/admin/posts/new?journal=${encodeURIComponent(journal.id)}`}>write</Button>
		</p>
	</section>
</AdminLayout>

<script>
	if (document.querySelector('[data-clear-draft]')) {
		try {
			localStorage.removeItem('post-draft');
		} catch {
			/* ignore */
		}
	}
</script>
