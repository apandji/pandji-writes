---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatDate } from '../../lib/site';
import { listJournalsForAdmin, listPostsForAdmin } from '../../lib/github';

const journals = await listJournalsForAdmin();
const journalTitle = Object.fromEntries(journals.map((journal) => [journal.id, journal.title]));
const drafts = (await listPostsForAdmin()).filter((post) => post.draft);
const clearDraftKey = Astro.url.searchParams.get('clear') ?? '';

function parseDay(value: string) {
	const date = new Date(`${value}T00:00:00Z`);
	return Number.isNaN(date.valueOf()) ? value : formatDate(date);
}
---

<AdminLayout
	title="drafts"
	crumbs={[
		{ href: '/admin', label: 'admin' },
		{ label: 'drafts' },
	]}
>
	{
		Astro.url.searchParams.get('saved') === 'draft' && (
			<p class="admin-note" data-clear-draft={clearDraftKey || 'post-draft:new'}>
				draft saved. it stays off the public site until you publish.
			</p>
		)
	}

	<section class="admin-section">
		<p class="admin-kicker">on this device</p>
		<ul class="admin-list" data-local-drafts hidden></ul>
		<p class="empty" data-local-empty hidden>nothing open on this browser.</p>
	</section>

	<section class="admin-section">
		<p class="admin-kicker">saved drafts</p>
		{
			drafts.length === 0 ? (
				<p class="empty">nothing waiting to publish.</p>
			) : (
				<ul class="admin-list">
					{drafts.map((post) => (
						<li>
							<a
								class="admin-journal-name"
								href={`/admin/posts/new?journal=${encodeURIComponent(post.journal)}&slug=${encodeURIComponent(post.id)}`}
							>
								{post.title}
							</a>
							<span class="admin-post-date">
								{(journalTitle[post.journal] ?? post.journal).toLowerCase()}
								· {parseDay(post.pubDate)}
							</span>
							<a
								class="admin-journal-write"
								href={`/admin/posts/new?journal=${encodeURIComponent(post.journal)}&slug=${encodeURIComponent(post.id)}`}
							>
								edit
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>

<script>
	const clearNode = document.querySelector<HTMLElement>('[data-clear-draft]');
	if (clearNode) {
		const key = clearNode.dataset.clearDraft;
		try {
			if (key) localStorage.removeItem(key);
			localStorage.removeItem('post-draft');
		} catch {
			/* ignore */
		}
	}

	const list = document.querySelector<HTMLUListElement>('[data-local-drafts]');
	const empty = document.querySelector<HTMLElement>('[data-local-empty]');
	if (list && empty) {
		const keys = Object.keys(localStorage).filter(
			(key) => key === 'post-draft' || key.startsWith('post-draft:'),
		);
		const items: { key: string; title: string; journal?: string }[] = [];
		for (const key of keys) {
			try {
				const draft = JSON.parse(localStorage.getItem(key) || '') as {
					title?: string;
					body?: string;
					journal?: string;
				};
				if (!draft.body?.trim() && !draft.title?.trim()) continue;
				items.push({
					key,
					title: draft.title?.trim() || 'untitled',
					journal: draft.journal,
				});
			} catch {
				/* ignore */
			}
		}

		if (items.length === 0) {
			empty.hidden = false;
		} else {
			list.hidden = false;
			for (const item of items) {
				const li = document.createElement('li');
				const resume =
					item.key === 'post-draft' || item.key === 'post-draft:new'
						? `/admin/posts/new?resume=1${item.journal ? `&journal=${encodeURIComponent(item.journal)}` : ''}`
						: `/admin/posts/new?slug=${encodeURIComponent(item.key.replace(/^post-draft:/, ''))}&resume=1`;
				li.innerHTML = `<a class="admin-journal-name" href="${resume}">continue</a><span class="admin-post-date">${item.title}</span>`;
				list.append(li);
			}
		}
	}
</script>
