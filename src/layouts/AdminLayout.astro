---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export type AdminCrumb = {
	href?: string;
	label: string;
};

interface Props {
	title?: string;
	wide?: boolean;
	crumbs?: AdminCrumb[];
}

const { title, wide = false, crumbs = [] } = Astro.props;
const pageTitle = title ?? 'admin';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>{pageTitle}</title>
		<ClientRouter />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<script is:inline>
			(() => {
				const themes = ['light', 'dark', 'e-ink'];
				const stored = localStorage.getItem('theme');
				const theme = themes.includes(stored)
					? stored
					: window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="is-admin">
		<div class:list={[wide ? 'wrap wrap--wide' : 'wrap']}>
			<header class="site-header">
				{
					crumbs.length > 0 ? (
						<nav class="site-crumbs" aria-label="breadcrumb">
							{crumbs.map((crumb, index) => (
								<>
									{index > 0 && (
										<span class="site-crumbs-sep" aria-hidden="true">
											/
										</span>
									)}
									{index === 0 ? (
										<a class="site-title" href={crumb.href || '/admin'}>
											{crumb.label}
										</a>
									) : crumb.href ? (
										<a class="site-crumb" href={crumb.href}>
											{crumb.label}
										</a>
									) : (
										<span class="site-crumb" aria-current="page">
											{crumb.label}
										</span>
									)}
								</>
							))}
						</nav>
					) : (
						<a class="site-title" href="/admin">
							admin
						</a>
					)
				}
				<nav class="admin-nav">
					<a href="/admin/history">history</a>
					<form method="post" action="/api/admin/logout">
						<button class="theme-toggle" type="submit">log out</button>
					</form>
					<button class="theme-toggle" type="button" data-theme-toggle>dark</button>
				</nav>
			</header>
			<main class="page">
				<slot />
			</main>
		</div>
		<script>
			const themes = ['light', 'dark', 'e-ink'] as const;
			const button = document.querySelector('[data-theme-toggle]');
			const root = document.documentElement;

			function nextTheme(current: string | undefined) {
				const index = themes.indexOf(current as (typeof themes)[number]);
				return themes[(index + 1) % themes.length];
			}

			function label() {
				if (!button) return;
				button.textContent = nextTheme(root.dataset.theme);
			}

			function setTheme(theme: string) {
				root.dataset.theme = theme;
				localStorage.setItem('theme', theme);
				label();
				root.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
			}

			label();
			button?.addEventListener('click', () => {
				setTheme(nextTheme(root.dataset.theme));
			});
		</script>
	</body>
</html>
